{
  "permissions": {
    "allow": [
      "Bash(./run-tests.sh)",
      "Bash(luau:*)",
      "Bash(luau-analyze:*)",
      "Bash(rojo build:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-negative-fixtures.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/luau-analyze-edited.sh\""
          }
        ]
      }
    ]
  }
}
